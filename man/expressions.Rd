\itemize{
\item \code{+}, \code{-}, \code{*}, \code{/} and \code{^};
\item \code{abs()}, \code{sqrt()}, \code{exp()}, \code{log()}, \code{sin()} and \code{cos()};
\item \code{sum()}, \code{prod()}, \code{max()}, \code{min()} and \code{mean()}.
}

